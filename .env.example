# Backend API base URL (register + auth derive full paths from this)
BE_API_BASE=http://localhost:3000

# Cloudflare Turnstile Site Key
# For local development testing, you can use: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Do NOT set NODE_ENV here - `next dev` / `next build` manage it. Forcing
# production locally flips the session cookie's Secure flag and breaks login.

# Secret sent as x-cf-bypass on BFF-to-backend calls.
CLOUDFLARE_BYPASS_SECRET=dev-bypass-secret

# Login rate limiting (frontend proxy, per-instance in-memory)
# Max login attempts per IP before lockout (default 10)
RATE_LIMIT_MAX_REQUESTS=10
# Lockout window in minutes; also the cooldown shown on 429 (default 15)
RATE_LIMIT_WINDOW_MINUTES=15
